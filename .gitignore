# ========================================================
# Git Ignore - Vaishno Karthik Web Application
# ========================================================

# Environments & Secrets
.env
.env.local
.env.*.local
*.env

# Python & Virtual Environments
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
*.db
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend Build Outputs
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploads & Media
backend/uploads/*
!backend/uploads/.gitkeep

# IDEs & OS Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Antigravity artifacts (transcripts, tasks)
.system_generated/
